# Copie este arquivo para .env.local e preencha com o config do app Web do Firebase.
# São valores públicos do SDK cliente. A proteção real dos dados fica nas firestore.rules.
VITE_FIREBASE_API_KEY=cole_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=cole_aqui
